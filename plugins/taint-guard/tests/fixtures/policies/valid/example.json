{
  "$schema": "https://raw.githubusercontent.com/dortort/claude-plugins/main/plugins/taint-guard/schema/taint-guard.schema.json",
  "version": 1,
  "mode": "enforce",
  "subagents": "shared",
  "resetOnClear": true,
  "userDeclassify": "confirm",
  "onUnknownHistory": "assume-tainted",
  "labels": {
    "private": {
      "description": "Data the user owns: mail, documents, chats"
    },
    "untrusted": {
      "description": "Text written by third parties"
    },
    "secret": {
      "description": "Credentials and keys"
    }
  },
  "sources": [
    {
      "id": "gmail-read",
      "match": {
        "tool": {
          "regex": "^mcp__(claude_ai_)?(gmail|google[_-]?mail)[^_]*__(.*_)?(get|read|search|list|fetch|download|history)",
          "flags": "i"
        }
      },
      "on": "attempt",
      "taints": [
        "private",
        "untrusted"
      ]
    },
    {
      "id": "web-content",
      "match": {
        "tool": {
          "anyOf": [
            "WebFetch",
            "WebSearch"
          ]
        }
      },
      "on": "success",
      "taints": [
        "untrusted"
      ]
    },
    {
      "id": "secret-files",
      "match": {
        "tool": {
          "exact": "Read"
        },
        "arguments": [
          {
            "pointer": "/file_path",
            "matches": "(^|/)([.]env[^/]*|id_(rsa|ed25519|ecdsa)|credentials)$"
          }
        ]
      },
      "on": "attempt",
      "taints": [
        "secret"
      ]
    }
  ],
  "sinks": [
    {
      "id": "no-shell-after-mail",
      "when": {
        "anyOf": [
          "private",
          "secret"
        ]
      },
      "block": [
        {
          "tool": {
            "exact": "Bash"
          }
        }
      ],
      "action": "deny",
      "reason": "Bash is disabled because this session has read private mail or secrets."
    },
    {
      "id": "outbound-after-untrusted-private",
      "when": {
        "allOf": [
          "private",
          "untrusted"
        ]
      },
      "block": [
        {
          "tool": {
            "exact": "WebFetch"
          }
        },
        {
          "tool": {
            "regex": "^mcp__.+__(.*_)?(send|post|reply|forward|create|update|upload|share|schedule|comment|invite)",
            "flags": "i"
          }
        }
      ],
      "except": [
        {
          "tool": {
            "regex": "^mcp__(claude_ai_)?(gmail|google[_-]?mail)[^_]*__(.*_)?create_draft$",
            "flags": "i"
          }
        }
      ],
      "action": "ask",
      "reason": "This would send data out of a session that holds private, third-party content."
    }
  ]
}
